# Copy this file to .env and fill in your credentials.
# Never commit .env — it is listed in .gitignore.

# Supabase project URL (found in your Supabase project → Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase anonymous/public key (safe to expose to clients, but restrict with RLS)
EXPO_PUBLIC_SUPABASE_KEY=<your-supabase-anon-key>

# Google Maps API key — restrict to your app's SHA-1 / bundle ID in Google Cloud Console
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=<your-google-maps-api-key>
